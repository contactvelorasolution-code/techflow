# ============================================================
#  TECHFLOW POS — Variables d'environnement Render
#  Ajouter ces variables dans Render → Environment
# ============================================================

# 1. PostgreSQL Supabase
# Supabase → Settings → Database → Connection string → URI
DATABASE_URL=postgresql://postgres:[MOT_DE_PASSE]@db.[REF].supabase.co:5432/postgres

# 2. Session secret (chaîne aléatoire longue)
SESSION_SECRET=remplacer_par_une_chaine_aleatoire_longue

# 3. Supabase API
# Supabase → Settings → API
SUPABASE_URL=https://[REF].supabase.co
SUPABASE_SERVICE_KEY=eyJ...votre_service_role_key...

# 4. Nom du bucket Supabase Storage (créer bucket PUBLIC avec ce nom)
SUPABASE_BUCKET=uploads

# 5. Environnement
NODE_ENV=production
